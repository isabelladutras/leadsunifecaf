rules_version = '2';

// Quem acessa:
// - a administradora (e-mail abaixo) acessa e altera tudo;
// - as vendedoras veem todos os leads, mas só alteram os delas e os que estão sem vendedora;
// - a Permanência vê os leads e altera só os alunos matriculados; também acessa o painel acadêmico.
service cloud.firestore {
  match /databases/{database}/documents {

    function logada() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function ehAdmin() {
      return logada() && email() in ['bellasdutra16@gmail.com'];
    }
    function equipe() {
      return get(/databases/$(database)/documents/config/equipe).data;
    }
    function temEquipe() {
      return exists(/databases/$(database)/documents/config/equipe);
    }
    function daEquipe() {
      return logada() && (ehAdmin() || (temEquipe() && email() in equipe().get('emails', [])));
    }
    function doAcademico() {
      return logada() && (ehAdmin() || (temEquipe() && email() in equipe().get('emailsAcademico', [])));
    }
    function meuNome() {
      return equipe().get('nomePorEmail', {}).get(email(), '__sem_nome__');
    }
    function donaDoLead() {
      return resource.data.get('responsavel', '') == '' || resource.data.get('responsavel', '') == meuNome();
    }

    match /leads/{id} {
      allow read: if daEquipe();
      allow create: if daEquipe();
      allow update: if ehAdmin()
        || (daEquipe() && !(email() in equipe().get('emailsAcademico', [])) && donaDoLead())
        || (doAcademico() && resource.data.get('etapa', '') == 'matriculado');
      allow delete: if ehAdmin();
    }

    match /config/{doc} {
      allow read: if daEquipe();
      allow write: if ehAdmin();
    }

    match /lidos/{doc} {
      allow read, write: if daEquipe();
    }

    // Números excluídos (não existem): ficam bloqueados para não voltarem por planilha ou cadastro.
    match /bloqueados/{tel} {
      allow read, write: if daEquipe();
    }

    match /academico/{doc} {
      allow read, write: if doAcademico();
    }
  }
}
